<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexusERP.Api</RootNamespace>
    <UserSecretsId>6538f8e2-524e-470e-b2df-917ade85341e</UserSecretsId>
    <!-- The /// summaries on controller actions become the operation summaries in Swagger UI. Not every public member is
         documented, so the "missing XML comment" warning (CS1591) is off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.30">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NexusERP.Application\NexusERP.Application.csproj" />
    <ProjectReference Include="..\NexusERP.Infrastructure\NexusERP.Infrastructure.csproj" />
  </ItemGroup>

  <!-- A running NexusERP.Api.exe locks the DLLs in bin\ and fails the build with MSB3026/MSB3027. Only this process is
       stopped (never dotnet.exe, which would also stop other .NET services such as the Khazar backend). -->
  <Target Name="KillNexusERPBeforeBuild" BeforeTargets="BeforeBuild" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="taskkill /IM NexusERP.Api.exe /F 2&gt;&amp;1" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" />
  </Target>

</Project>
